{
  "name": "hermes-approved-memory-mirror",
  "version": "0.4.5",
  "description": "A safe local approved-memory mirror CLI for James.",
  "type": "module",
  "bin": {
    "hermes": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "ui": "tsx src/ui.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
